# FitTent Backend Environment Variables
# Copy this file to .env and fill in your credentials.

# ── Flask Session Secret Key ──────────────────────────────────
# IMPORTANT: Set this to a long random string in production.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Google OAuth ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create a project
# 2. Enable "Google+ API" or "Google Identity"
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized Redirect URI: http://127.0.0.1:5002/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Apple Sign-In ─────────────────────────────────────────────
# Requires Apple Developer Account ($99/yr)
# Apple Sign-In requires HTTPS — use a reverse proxy or ngrok for local dev
APPLE_CLIENT_ID=com.yourcompany.fittent
APPLE_KEY_ID=your-apple-key-id
APPLE_TEAM_ID=your-apple-team-id
# Path to your downloaded AuthKey_XXXXX.p8 file
APPLE_PRIVATE_KEY_PATH=./apple_private_key.p8

# ── Phone OTP (Twilio) ────────────────────────────────────────
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550000000
